ARG UBUNTU_VERSION=22.04
ARG RUST_VERSION=nightly

# Builder stage
FROM ubuntu:${UBUNTU_VERSION} AS builder

ARG RUST_VERSION

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    clang \
    libclang-dev \
    curl \
    xz-utils \
    pkg-config \
    libssl-dev \
    zlib1g-dev \
    libtinfo-dev \
    libxml2-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Rust
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain ${RUST_VERSION}
ENV PATH="/root/.cargo/bin:${PATH}"

# Copy source code and essential files
COPY . .

# Build the application
RUN cargo build --release -p ferrules-api

# Runtime stage
FROM ubuntu:${UBUNTU_VERSION}

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    libssl3 \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create app directory structure
RUN mkdir -p /app/models

# Copy the binary and libs from builder
COPY --from=builder /app/target/release/ferrules-api /app/ferrules-api
COPY --from=builder /app/target/release/*onnxruntime*.so* /usr/local/lib/

# Copy runtime dependencies
COPY --from=builder /app/models/ /app/models/
COPY --from=builder /app/font/ /app/font/
COPY --from=builder /app/libs/ /app/libs/

# Verify all required files are present
RUN echo "Verifying model files..." && \
    test -f /app/models/yolov8s-doclaynet.onnx && \
    echo "✓ Model files verified" && \
    echo "File verification complete!"

# Set library path and working directory
RUN ldconfig
WORKDIR /app

ENTRYPOINT ["/app/ferrules-api"]
