# ============================================================================
# Ferrules-Specific Ignores
# ============================================================================
# Note: Common patterns (.DS_Store, .venv, target/, .env) are in root .gitignore

**/.DS_Store
**/.serena
**/target

# Model files and archives
model-archive/
models/
*.pt

# Test data and output directories
test_data/*
*.pdf
*-results/
*-output/
*-debug*/
baseline-output/
new-output/
todo/
