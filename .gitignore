model-archive/

# Test data and output directories
test_data/*
*.pdf
*-results/
*-output/
*-debug*/
baseline-output/
new-output/
todo/

**/.venv/
*.pt
test_data/*

models/*
!models/table-transformer-structure-recognition_fp16.onnx
!models/table-transformer-structure-recognition-ane-b4.onnx
!models/table-transformer-structure-recognition_fp16.onnx
!models/ocr/
**/.env
**/examples/
